# Copie este arquivo para .env e troque SUA_SENHA pela senha do usuário
# "postgres" definida na instalação do PostgreSQL. O .env não vai para o git.

# Banco de desenvolvimento.
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/ufvet"

# Banco usado só pelos testes automatizados. Pode ser apagado e recriado à
# vontade, por isso fica separado do de desenvolvimento.
TEST_DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/ufvet_test"

# Chaves dos dados pessoais cifrados (CPF, e-mail e telefone): 32 bytes
# aleatórios em base64 cada uma, e diferentes entre si. Para gerar uma:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde uma cópia fora do computador: sem as chaves, esses dados não voltam.
# Num ambiente que já tem dados, use as mesmas chaves de antes, nunca novas.
CHAVE_CIFRAGEM="GERE_UMA_CHAVE"
CHAVE_INDICE="GERE_OUTRA_CHAVE"
