# Copie este arquivo para .env e preencha. O .env guarda segredos e não vai
# para o git.

# Banco de desenvolvimento. Troque SUA_SENHA pela senha do usuário "postgres"
# definida na instalação do PostgreSQL.
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/ufvet"

# Banco usado só pelos testes automatizados. Pode ser apagado e recriado à
# vontade, por isso fica separado do de desenvolvimento.
TEST_DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/ufvet_test"

# As três chaves abaixo são 32 bytes aleatórios em base64, cada uma diferente
# das outras. Para gerar uma:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Chaves dos dados pessoais cifrados (CPF, e-mail e telefone). Guarde uma
# cópia fora do computador: sem elas, esses dados não voltam. Num ambiente que
# já tem dados, use as mesmas chaves de antes, nunca novas.
CHAVE_CIFRAGEM="GERE_UMA_CHAVE"
CHAVE_INDICE="GERE_OUTRA_CHAVE"

# Assina os crachás de sessão (login). Pode ser trocada a qualquer momento: a
# troca só desconecta todo mundo, que precisa entrar de novo.
JWT_SEGREDO="GERE_MAIS_UMA_CHAVE"

# Opcionais.
# Porta em que a API atende (padrão: 3000; o site espera esta).
# PORTA=3000
# Quantos intermediários (proxies) a hospedagem põe na frente da API (padrão:
# 0, no computador). Ver src/config.js.
# PROXIES_CONFIAVEIS=1
